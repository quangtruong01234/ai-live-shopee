# Mẫu biến môi trường. Copy thành .env rồi điền giá trị. KHÔNG commit .env.
# Tên biến là bản đề xuất; khi có code cấu hình thì cập nhật cho khớp.

# ---------- Chung ----------
APP_ENV=dev                     # dev | demo | prod
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------- Chọn adapter ----------
COMMENT_SOURCE=mock             # mock | youtube | shopee
TTS_PROVIDER=fake               # fake | vieneu (CPU, trên laptop) | gemini (free tier), ADR-024; máy chạy phiên đặt vieneu (T049)
AVATAR_MODE=static              # static (ảnh tĩnh) | livetalking (nhép miệng trên GPU laptop, ADR-023; RunPod là dự phòng)
OUTPUT_MODE=webrtc              # webrtc | virtualcam | rtmp
QUEUE_BACKEND=memory            # memory | redis
REPLY_ENGINE=chain              # chain | gemini | fake (chain: chuỗi model ADR-035/037; fake: chạy không cần API key)

# ---------- LLM (Gemini API, free tier: ADR-018) ----------
GEMINI_API_KEY=                 # tạo ở Google AI Studio; free tier: không gửi dữ liệu cá nhân hay bí mật
LLM_MODEL=gemini-3.8-flash       # TODO: chốt sau benchmark (so với gemini-3.5-flash-lite)
LLM_THINKING_LEVEL=low
LLM_MAX_TOKENS=300
LLM_TIMEOUT_S=8                 # timeout mỗi lượt gọi LLM (Điều VIII)

# ---------- Chuỗi model LLM (REPLY_ENGINE=chain, feature 008, ADR-035/037/038) ----------
# Mảng JSON một dòng, thử theo thứ tự. Tổng first_sentence_timeout_s phải <= min(LLM_TIMEOUT_S, SCRIPT_LLM_TIMEOUT_S).
# Mục có "platform" đi qua freellmapi và phải đúng nền tảng đã chấm (X-Routed-Via); key_env là TÊN biến chứa key.
LLM_CHAIN=[{"label":"sealion","base_url":"http://127.0.0.1:3001/v1","model":"gemma-sea-lion-v4-27b","key_env":"FREELLMAPI_KEY","platform":"cloudflare","first_sentence_timeout_s":2.5},{"label":"qwen","base_url":"https://api.groq.com/openai/v1","model":"qwen/qwen3.8-27b","key_env":"GROQ_API_KEY","first_sentence_timeout_s":2.0,"params":{"reasoning_effort":"none"}}]
# ADR-040: gpt-oss-120b qua freellmapi bị bỏ khỏi chuỗi mặc định (không đạt SC-001 ở T055). Mục cũ, chỉ để tham khảo:
#   {"label":"gptoss","base_url":"http://127.0.0.1:3001/v1","model":"gpt-oss-120b","key_env":"FREELLMAPI_KEY","platform":"groq","first_sentence_timeout_s":2.0,"params":{"reasoning_effort":"low"}}
# Mục 4 (Gemini qua freellmapi): chỉ thêm vào cuối mảng sau khi qua bộ kiểm US4 (`qa_eval run --entry gemini`), ví dụ:
#   {"label":"gemini","base_url":"http://127.0.0.1:3001/v1","model":"TODO","key_env":"FREELLMAPI_KEY","platform":"TODO","first_sentence_timeout_s":0.5}
# TODO: tên model Gemini và id nền tảng trên freellmapi; giới hạn chờ của mục 4 (contracts/config.md §2 của spec 008).
LLM_CHAIN_COOLDOWN_S=60         # nghỉ cố định (giây) cho mục lỗi trước câu đầu, trừ lỗi blocked
FREELLMAPI_KEY=                 # key thống nhất của freellmapi (freellmapi-...), ADR-034
GROQ_API_KEY=                   # key Groq gọi thẳng (gsk_...)

# ---------- TTS (spec 003, ADR-024) ----------
# TTS_PROVIDER ở khối "Chọn adapter" phía trên.
TTS_SAMPLE_RATE=16000             # hợp đồng chung PCM16 mono 16 kHz (ADR-025)
TTS_TIMEOUT_S=5                   # timeout mỗi lần chờ chunk tiếng (đầu và giữa hai chunk), không phải cả câu
TTS_QUOTA_COOLDOWN_S=60           # sau lỗi hết hạn mức, từ chối ngay trong N giây (không thử lại liên tục)
FAKE_TTS_DELAY_MS=0               # giả lập độ trễ của FakeTTS
VIENEU_VOICE=Thùy Dung            # giọng nữ miền Nam có sẵn; người dùng chọn sau khi nghe thử (T049, research R1)
VIENEU_REF_AUDIO=                 # tùy chọn: WAV đoạn mẫu do chính VIENEU_VOICE đọc, ngoài git (FR-002, research R1); trống = giọng có sẵn
VIENEU_CPU_THREADS=4              # đã đo 2 / 4 / 6 ở T049, giữ 4 (research R1)
VIENEU_MODEL_CACHE=~/.cache/ai-live/hf   # cache model riêng (581 MB), ngoài repo, không symlink (research R1)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Leda             # chốt sau khi nghe thử (SC-006); dùng chung GEMINI_API_KEY ở trên
TTS_ABBREVIATIONS_PATH=data/rules/tts_abbreviations.json   # bảng viết tắt đọc thành chữ (data-model §3)

# ---------- Avatar / LiveTalking ----------
CUSTOMER_ID=                    # mã khách của phiên; nhân vật của khách khác bị từ chối (FR-004)
AVATAR_ID=                      # mỗi avatar chỉ gán cho đúng 1 tài khoản/khách; phải trùng character_id
AVATAR_DIR=assets/avatars/demo_host_01   # thư mục nhân vật (character.json, face.png, clips/); đã gitignore
AVATAR_STATIC_IMAGE=assets/avatars/demo/idle.png   # chỉ dùng ở AVATAR_MODE=static
AVATAR_FALLBACK_AFTER=2         # số lượt lỗi tạo hình liền nhau trước khi tự về ảnh tĩnh
LIVETALKING_URL=http://127.0.0.1:8010    # cổng mặc định listenport của LiveTalking
LIVETALKING_PYTHON=vendor/livetalking/.venv/Scripts/python.exe   # Python của venv fork, cho lệnh prepare
LIVETALKING_FIRST_FRAME_TIMEOUT_S=10
LIVETALKING_RECONNECT_MAX_S=10
LIVETALKING_LEAD_S=0            # >0: speak trả về sớm chừng ấy giây trước khi câu phát xong, giảm khoảng lặng giữa câu (R15)
LIVETALKING_BATCH_SIZE=16       # fork đọc; nhỏ hơn thì khung đầu sớm hơn, thông lượng thấp hơn
LIVETALKING_LIP_EVERY_N=1       # fork đọc; 2 = suy luận miệng mỗi khung thứ 2 khi máy không kịp
LIVETALKING_TRANSITION_S=0.3    # fork đọc; thời gian trộn khi đổi clip
LIVETALKING_HOLD_S=1.5          # fork đọc; giữ clip nói (miệng khép) chừng ấy giây sau câu rồi mới về clip chờ
AILIVE_RECORD_DIR=              # fork đọc; tự kiểm: ghi luồng ra mp4/wav/jsonl vào đây (vd out/selfcheck, ngoài git); trống = tắt
AILIVE_RECORD_MAX_S=600         # fork đọc; mỗi bản ghi tự dừng sau chừng ấy giây
AI_LABEL_TEXT=AI                # ở livetalking chỉ dùng chữ ASCII
AI_LABEL_POSITION=top-right
RENDERER_ACK_TIMEOUT_S=3        # chờ trang host báo bắt đầu phát

# ---------- Nguồn comment ----------
COMMENT_MAX_AGE_S=30            # bỏ comment cũ hơn ngưỡng này
COMMENT_QUEUE_MAX=50
COMMENT_DEDUP_WINDOW_S=60
COMMENT_MAX_CHARS=300
PROFANITY_LIST_PATH=data/rules/profanity.txt
PRIORITY_RULES_PATH=data/rules/priority_keywords.json
YOUTUBE_API_KEY=                # TODO: Live Chat API cần API key hay OAuth cho trường hợp này?
YOUTUBE_VIDEO_ID=
YOUTUBE_LIVE_CHAT_ID=

# ---------- Show kịch bản (feature 004) ----------
SCRIPT_SEGMENT_MIN_SENTENCES=3                 # số câu tối thiểu mỗi phân đoạn
SCRIPT_SEGMENT_MAX_SENTENCES=6                 # phải >= min, nếu không app không khởi động
SCRIPT_PRIMARY_SHARE=0.5                       # tỷ lệ phân đoạn của sản phẩm chính, 0.5–0.9
SCRIPT_FALLBACK_AFTER=3                        # số phân đoạn lỗi LLM liên tiếp trước khi sang chế độ dự phòng
SCRIPT_LLM_TIMEOUT_S=10                        # timeout sinh cả một phân đoạn
SCRIPT_RETRY_TIMEOUT_S=4                       # thời hạn thử sinh lại trong chế độ dự phòng
SCRIPT_HISTORY_SENTENCES=12                    # số câu đã nói gần nhất gửi kèm prompt
SCRIPT_MAX_TOKENS=600                          # max_output_tokens của narrate()
PLATFORM_PHRASES_PATH=data/rules/platform_phrases.txt   # cụm cơ chế nền tảng bị chặn; thiếu file thì app không khởi động
CLAIM_PHRASES_PATH=data/rules/claim_phrases.txt         # cụm khẳng định không có căn cứ bị chặn (ADR-050); thiếu file thì app không khởi động

# ---------- Output ----------
RTMP_URL=                       # vd. rtmp://a.rtmp.youtube.com/live2
RTMP_STREAM_KEY=                # secret: không log, không commit

# ---------- Dữ liệu ----------
PRODUCT_DATA_PATH=data/products/demo.docx      # file Word theo mẫu (ADR-014)
CONTENT_MAX_BYTES=5242880                     # 5 MB, giới hạn file nội dung nạp giữa phiên
SESSION_DATA_DIR=data/sessions                # log JSONL từng phiên (không commit)
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Shopee (giai đoạn 2) ----------
SHOPEE_SESSION_PATH=secrets/shopee_session.enc   # file đã mã hóa, chỉ nằm trên máy chạy
SHOPEE_SESSION_KEY=                              # TODO: Fernet key / DPAPI / keyring? (ADR-010)

# ---------- Hạ tầng (tùy chọn) ----------
RUNPOD_API_KEY=
